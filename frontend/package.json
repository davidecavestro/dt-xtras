{
  "name": "dt-xtras-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:e2e": "npx playwright install && playwright test",
    "test:e2e:headed": "npx playwright install && playwright test --headed",
    "test:e2e:ui": "npx playwright install && playwright test --ui",
    "test:e2e:debug": "npx playwright install && playwright test --debug",
    "test:e2e:ci": "npm run build && npm run preview -- --port 4173 --host & sleep 3&& npx playwright install && npx playwright test; kill %1",
    "test:all": "npm run test:run && npm run test:e2e:ci",
    "test:all:local": "npm run test:run && npm run test:e2e"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@tailwindcss/postcss": "^4.2.2",
    "axios": "^1.15.0",
    "cytoscape": "^3.33.2",
    "cytoscape-dagre": "^2.5.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "regexpp": "^3.2.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "vue3-tree-vue": "^2.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.0.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.27",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.8",
    "vitest": "^4.0.0"
  }
}
