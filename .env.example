# DT-Xtras Environment Configuration
# Copy this to .env for Docker Compose setup

# Dependency-Track Configuration
DT_API_URL=https://your-dt-instance.com/api
DT_FRONTEND_URL=https://your-dt-instance.com

# Backend API URL (optional, defaults to http://localhost:8000)
BACKEND_API_URL=http://localhost:8001

# Allow specific frontend URL
CORS_ORIGINS="https://myapp.example.com"

# Allow multiple origins
CORS_ORIGINS="http://localhost:3000,https://staging.example.com,https://prod.example.com"

# Allow all origins (not recommended for production)
CORS_ORIGINS="*"

# Restrict methods
CORS_ALLOW_METHODS="GET,POST,PUT"
