# dt-xtras environment configuration
# Copy this file to .env for the Docker Compose setup (see README "Getting Started").

# --- Your existing Dependency-Track instance ---
# DT API server base URL. The backend appends /api/v1 itself, so do NOT include it here.
# Use host.docker.internal to reach a Dependency-Track running on your own machine.
DT_API_URL=http://host.docker.internal:8080
# DT web UI URL (used for "view in DT" style links).
DT_FRONTEND_URL=http://localhost:8080

# --- dt-xtras backend, as reached from your browser ---
# Must match the backend port published by compose.yml (8001).
BACKEND_API_URL=http://localhost:8001

# --- CORS: which browser origins the backend accepts ---
# The dt-xtras frontend is published on port 3001 by compose.yml.
# Comma-separate multiple origins, or use "*" to allow any (handy locally, not for production).
CORS_ORIGINS=http://localhost:3001
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# --- Security ---
# Secret used to sign dt-xtras session tokens. The backend ships with an insecure default,
# so set a long random value for any non-local deployment, e.g.:
#   openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-secret
