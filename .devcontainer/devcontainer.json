{
  "name": "dt-xtras",
  "dockerComposeFile": "compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${localWorkspaceFolder}/.home_vscode_claude,target=/home/vscode/.claude,type=bind"
  ],
  "runServices": [
    "app",
    "dtrack-db",
    "dtrack-apiserver",
    "dtrack-frontend"
  ],
  "forwardPorts": [
    8000,
    5173,
    8080,
    3000,
    9323
  ],
  "portsAttributes": {
    "8000": {
      "label": "Backend API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Frontend Dev Server",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Dependency Track API",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Dependency Track Frontend",
      "onAutoForward": "notify"
    },
    "9323": {
      "label": "Playwright Test Report",
      "onAutoForward": "notify"
    }
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "moby": false,
      "installDockerBuildx": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "matangover.mypy",
        "Vue.volar",
        "ms-azuretools.vscode-docker",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-json",
        "github.vscode-github-actions"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/opt/venv/bin/python"
      }
    }
  }
}
