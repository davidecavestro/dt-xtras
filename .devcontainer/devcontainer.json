{
  "name": "dt-xtras",
  "dockerComposeFile": "compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "runServices": [
    "app",
    "dtrack-db",
    "dtrack-apiserver",
    "dtrack-frontend"
  ],
  "forwardPorts": [
    8000,
    5173,
    8080,
    3000
  ],
  "portsAttributes": {
    "8000": {
      "label": "Backend API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Frontend Dev Server",
      "onAutoForward": "notify"
    },
    "8080": {
      "label": "Dependency Track API",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "Dependency Track Frontend",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.black-formatter",
        "ms-python.flake8",
        "matangover.mypy",
        "Vue.volar",
        "ms-azuretools.vscode-docker",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.vscode-json"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python"
      }
    }
  }
}
